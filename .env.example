# ==============================================================================
# NourishNet – Smart Food Recovery & Redistribution Platform
# Environment Configuration Template
# ==============================================================================

# Server & Networking
# CRITICAL: Host port MUST remain 3001 to prevent collisions with existing projects on 3000.
PORT=3001
PUBLIC_PORT=3001
NODE_ENV=development

# Application URLs
APP_URL="http://localhost:3001"
VITE_API_URL="http://localhost:3001"

# Cryptographic & Session Secrets
# High-entropy secret key for server-side HMAC session tokens, QR tokens, and OTP generation.
RECOVERY_SIGNING_SECRET="nourishnet_surat_cryptographic_signing_secret_example_2026"

# Demo Mode Configuration
# Controls whether demo mode (Ctrl shortcut, 25 Surat accounts, floating bar) is enabled.
# Set to 'false' to disable demo mode in strict production deployments.
DEMO_MODE=true
VITE_DEMO_MODE=true

# External AI Service (Optional - used for smart recovery optimization)
GEMINI_API_KEY=""
